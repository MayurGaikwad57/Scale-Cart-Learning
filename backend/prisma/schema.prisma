// ScaleCart schema (Phase 1: modular monolith).
// Money is stored as integer cents. IDs are UUIDs so they can move across services/shards later.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")

  cart          Cart?
  orders        Order[]
  notifications Notification[]

  @@map("users")
}

model Product {
  id         String   @id @default(uuid()) @db.Uuid
  sku        String   @unique
  name       String
  description String  @default("")
  priceCents Int      @map("price_cents")
  category   String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]
  stockAlert StockAlert?

  // Serves the catalog filter (category) + price sort/range.
  @@index([category, priceCents])
  @@map("products")
}

// 1:1 with product. CHECK (available >= 0) is added in the migration SQL (Prisma can't express it).
// "version" is reserved for the optimistic-locking comparison in the concurrency lesson.
model Inventory {
  productId String  @id @map("product_id") @db.Uuid
  available Int
  reserved  Int     @default(0)
  version   Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model Cart {
  id     String     @id @default(uuid()) @db.Uuid
  userId String     @unique @map("user_id") @db.Uuid
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  @@map("cart")
}

// CHECK (quantity > 0) is added in the migration SQL.
model CartItem {
  id        String  @id @default(uuid()) @db.Uuid
  cartId    String  @map("cart_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  // One row per product per cart; also the index for "items of a cart".
  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  status         OrderStatus @default(PENDING)
  totalCents     Int         @map("total_cents")
  // Used from Phase 2 (idempotent order creation). Unique per user so keys can't collide across users.
  idempotencyKey String?     @map("idempotency_key")
  // SHA-256 of the request body that used the key: the same key with a DIFFERENT body is a client
  // bug (422), even after the fast ScaleKV record is gone.
  idempotencyFingerprint String? @map("idempotency_fingerprint")
  // M6: the ORDER SERVICE's own copy of what it knows about the payment. It no longer reads the
  // payments table (that belongs to the Payment Service); it learns the outcome from the
  // PaymentSucceeded / PaymentFailed events. Copying data between services is normal.
  paymentMethod  String?       @map("payment_method")
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  // Why a CANCELLED order was cancelled: payment_declined | inventory_unavailable | reservation_released
  statusReason   String?       @map("status_reason")
  createdAt      DateTime    @default(now()) @map("created_at")

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@unique([userId, idempotencyKey])
  // Serves order history: newest orders for a user.
  @@index([userId, createdAt(sort: Desc)])
  // M6: the reconciler's query "PENDING orders older than N seconds".
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantity       Int
  // Price snapshot: later product price changes must not rewrite history.
  unitPriceCents Int     @map("unit_price_cents")
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  amountCents Int           @map("amount_cents")
  status      PaymentStatus @default(PENDING)
  providerRef String?       @map("provider_ref")
  method      String?
  createdAt   DateTime      @default(now()) @map("created_at")
  order       Order         @relation(fields: [orderId], references: [id])

  // M6: ONE payment per order. The Payment Service can receive the same OrderCreated more than
  // once (at-least-once delivery, re-publishing); this constraint makes a double charge impossible.
  @@unique([orderId])
  @@map("payments")
}

// ---------------------------------------------------------------- M5: event consumers

// IDEMPOTENT CONSUMER ("inbox"): a consumer records every event it handled, IN THE SAME
// TRANSACTION as its side effect. Delivery is at-least-once, so the same event can arrive twice
// (crash before commit, rebalance, DLQ replay); the primary key makes the second one a no-op.
model ProcessedEvent {
  consumerGroup String   @map("consumer_group")
  eventId       String   @map("event_id") @db.Uuid
  processedAt   DateTime @default(now()) @map("processed_at")

  @@id([consumerGroup, eventId])
  @@map("processed_events")
}

// Written by the "notification" consumer group.
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orderId   String?  @map("order_id") @db.Uuid
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// Written by the "inventory" consumer group: products that ran low after a sale (one row per product).
model StockAlert {
  productId   String   @id @map("product_id") @db.Uuid
  available   Int
  lastOrderId String?  @map("last_order_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_alerts")
}

// Written by the "analytics" consumer group: a read model (projection) built purely from events.
model SalesDaily {
  day             DateTime @id @db.Date
  confirmedOrders Int      @default(0) @map("confirmed_orders")
  cancelledOrders Int      @default(0) @map("cancelled_orders")
  // BigInt (64-bit): a day's revenue summed in cents passes the 32-bit limit at about Rs 2.1 crore.
  revenueCents    BigInt   @default(0) @map("revenue_cents")

  @@map("sales_daily")
}

// ---------------------------------------------------------------- M6: Inventory Service

enum ReservationStatus {
  HELD // stock moved available -> reserved, waiting for the order's outcome
  COMMITTED // order confirmed: the reserved units are sold (reserved -= qty)
  RELEASED // order cancelled: units went back to available. Also a TOMBSTONE for a reservation
  // that never happened, so a late duplicate "reserve" for that order is refused.
}

// Owned by the Inventory Service. Note: NO foreign key to orders - orders belong to another
// service (in a real deployment, another database). Services refer to each other only by id.
model Reservation {
  orderId   String            @id @map("order_id") @db.Uuid
  status    ReservationStatus @default(HELD)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  items     ReservationItem[]

  @@index([status, createdAt])
  @@map("reservations")
}

model ReservationItem {
  orderId     String      @map("order_id") @db.Uuid
  productId   String      @map("product_id") @db.Uuid
  quantity    Int
  reservation Reservation @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@id([orderId, productId])
  @@map("reservation_items")
}
