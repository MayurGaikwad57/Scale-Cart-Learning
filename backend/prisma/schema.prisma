// ScaleCart schema (Phase 1: modular monolith).
// Money is stored as integer cents. IDs are UUIDs so they can move across services/shards later.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")

  cart   Cart?
  orders Order[]

  @@map("users")
}

model Product {
  id         String   @id @default(uuid()) @db.Uuid
  sku        String   @unique
  name       String
  description String  @default("")
  priceCents Int      @map("price_cents")
  category   String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  // Serves the catalog filter (category) + price sort/range.
  @@index([category, priceCents])
  @@map("products")
}

// 1:1 with product. CHECK (available >= 0) is added in the migration SQL (Prisma can't express it).
// "version" is reserved for the optimistic-locking comparison in the concurrency lesson.
model Inventory {
  productId String  @id @map("product_id") @db.Uuid
  available Int
  reserved  Int     @default(0)
  version   Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model Cart {
  id     String     @id @default(uuid()) @db.Uuid
  userId String     @unique @map("user_id") @db.Uuid
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  @@map("cart")
}

// CHECK (quantity > 0) is added in the migration SQL.
model CartItem {
  id        String  @id @default(uuid()) @db.Uuid
  cartId    String  @map("cart_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  // One row per product per cart; also the index for "items of a cart".
  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  status         OrderStatus @default(PENDING)
  totalCents     Int         @map("total_cents")
  // Used from Phase 2 (idempotent order creation). Unique per user so keys can't collide across users.
  idempotencyKey String?     @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at")

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@unique([userId, idempotencyKey])
  // Serves order history: newest orders for a user.
  @@index([userId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantity       Int
  // Price snapshot: later product price changes must not rewrite history.
  unitPriceCents Int     @map("unit_price_cents")
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  amountCents Int           @map("amount_cents")
  status      PaymentStatus @default(PENDING)
  providerRef String?       @map("provider_ref")
  createdAt   DateTime      @default(now()) @map("created_at")
  order       Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}
