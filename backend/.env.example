PORT=3000
DATABASE_URL="postgresql://scalecart:scalecart@localhost:5432/scalecart?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
CORS_ORIGIN="http://localhost:4300,http://localhost:4200"

# M4: our own key-value store (start it with: npm run kv). Remove this line to run without it.
KV_URL="kv://127.0.0.1:6380"

# Only behind a reverse proxy / load balancer: number of proxy hops, so rate limits see the real client IP.
# TRUST_PROXY=1

# M5: our own Kafka-like broker (start it with: npm run log). Remove to run without events.
LOG_URL="kv://127.0.0.1:9093"

# M6: microservices. PORT above is the API GATEWAY (the only port the browser uses). Defaults shown.
# ORDER_PORT=3001
# PAYMENT_PORT=3002
# INVENTORY_PORT=3003
# NOTIFICATION_PORT=3004
# Where services reach each other (default http://127.0.0.1:<port>), e.g. INVENTORY_SERVICE_URL="http://127.0.0.1:3003"
# Shared secret for service-to-service /internal calls - change it outside development.
# INTERNAL_TOKEN="scalecart-dev-internal-token"
# Simulated payment-provider latency in ms (so you can watch an order wait in PENDING).
# PAYMENT_DELAY_MS=1200
