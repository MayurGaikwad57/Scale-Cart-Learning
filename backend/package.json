{
  "name": "scalecart-backend",
  "version": "1.0.0",
  "main": "dist/src/services/gateway/main.js",
  "scripts": {
    "dev": "tsx --conditions=development src/scripts/dev-all.ts",
    "svc:gateway": "tsx watch --conditions=development src/services/gateway/main.ts",
    "svc:order": "tsx watch --conditions=development src/services/order/main.ts",
    "svc:payment": "tsx watch --conditions=development src/services/payment/main.ts",
    "svc:inventory": "tsx watch --conditions=development src/services/inventory/main.ts",
    "svc:notification": "tsx watch --conditions=development src/services/notification/main.ts",
    "kv": "tsx --conditions=development src/kv/kv-server.ts",
    "kv:cli": "tsx --conditions=development src/kv/kv-cli.ts",
    "log": "tsx --conditions=development src/log/log-server.ts",
    "log:cli": "tsx --conditions=development src/kv/kv-cli.ts --log",
    "worker": "tsx --conditions=development src/worker.ts",
    "build": "prisma generate && tsc -b",
    "start": "node dist/src/scripts/dev-all.js",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed": "tsx --conditions=development src/scripts/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalecart/events": "*",
    "@scalecart/service-kit": "*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
