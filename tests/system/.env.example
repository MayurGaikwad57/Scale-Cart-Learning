# The system tests run EVERY service in one process, so they need every service's database
# (npm run db:create-service-dbs writes these lines for you).
IDENTITY_DATABASE_URL="postgresql://identity_svc:CHANGE-ME@localhost:5432/scalecart_identity"
CATALOG_DATABASE_URL="postgresql://catalog_svc:CHANGE-ME@localhost:5432/scalecart_catalog"
ORDER_DATABASE_URL="postgresql://order_svc:CHANGE-ME@localhost:5432/scalecart_order"
INVENTORY_DATABASE_URL="postgresql://inventory_svc:CHANGE-ME@localhost:5432/scalecart_inventory"
PAYMENT_DATABASE_URL="postgresql://payment_svc:CHANGE-ME@localhost:5432/scalecart_payment"
NOTIFICATION_DATABASE_URL="postgresql://notification_svc:CHANGE-ME@localhost:5432/scalecart_notification"
# Keep the total small: 3 test files x 4 services x 5 = 60 connections (Postgres allows ~100)
DATABASE_POOL_MAX=5
# The identity service runs inside the test process too (npm run keys -w @scalecart/identity writes these)
JWT_PRIVATE_KEY="base64-of-a-PEM-private-key"
JWT_KEY_ID="scalecart-xxxxxxxx"
