# Local tooling only (copy to .env). NOT used by any service.
# A PostgreSQL user allowed to create roles and databases (for npm run db:create-service-dbs).
ADMIN_DATABASE_URL="postgresql://postgres:CHANGE-ME@localhost:5432/postgres"
# Only for the one-time move from the old shared database (npm run db:migrate-legacy-data).
LEGACY_DATABASE_URL="postgresql://postgres:CHANGE-ME@localhost:5432/scale_cart"
