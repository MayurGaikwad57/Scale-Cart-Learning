{
  "name": "@scalecart/scalekv",
  "version": "1.0.0",
  "private": true,
  "description": "ScaleKV: our own Redis-like key-value store (RESP protocol, port 6380).",
  "type": "module",
  "exports": {
    "./*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "tsx --conditions=development src/kv-server.ts",
    "start": "node dist/kv-server.js",
    "cli": "tsx --conditions=development src/cli.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@scalecart/service-kit": "*",
    "dotenv": "^18.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
