// NOTIFICATION SERVICE database (scalecart_notification) - only the tables it OWNS.
// userId / orderId are plain ids (users and orders live in the order service's database).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orderId   String?  @map("order_id") @db.Uuid
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  // The bell: newest notifications of one user.
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// Idempotent consumer ("notification" group): one row per event processed.
model ProcessedEvent {
  consumerGroup String   @map("consumer_group")
  eventId       String   @map("event_id") @db.Uuid
  processedAt   DateTime @default(now()) @map("processed_at")

  @@id([consumerGroup, eventId])
  @@map("processed_events")
}
