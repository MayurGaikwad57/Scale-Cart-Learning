# This service's OWN database and DB user (created by: npm run db:create-service-dbs)
IDENTITY_DATABASE_URL="postgresql://identity_svc:CHANGE-ME@localhost:5432/scalecart_identity"
# The token signing key - created by: npm run keys -w @scalecart/identity  (ONLY this service has it)
JWT_PRIVATE_KEY="base64-of-a-PEM-private-key"
JWT_KEY_ID="scalecart-xxxxxxxx"
# our own Redis (npm run kv): the login rate limit. Remove to run without it.
KV_URL="kv://127.0.0.1:6380"
