# This service's OWN database and DB user (created by: npm run db:create-service-dbs)
CATALOG_DATABASE_URL="postgresql://catalog_svc:CHANGE-ME@localhost:5432/scalecart_catalog"
# our own Redis (npm run kv): the product cache. Remove to run without it.
KV_URL="kv://127.0.0.1:6380"
# our own Kafka (npm run log): product events + stock updates. Remove to run without events.
LOG_URL="kv://127.0.0.1:9093"
