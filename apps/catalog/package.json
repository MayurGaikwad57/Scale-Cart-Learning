{
  "name": "@scalecart/catalog",
  "version": "1.0.0",
  "private": true,
  "description": "Catalog service: products, search, admin product CRUD, product cache; publishes ProductCreated/Updated, keeps a stock copy from StockChanged.",
  "type": "module",
  "exports": {
    "./*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node dist/main.js",
    "build": "prisma generate && tsc -b",
    "typecheck": "tsc -b",
    "worker": "tsx --conditions=development src/worker.ts",
    "seed": "tsx --conditions=development src/scripts/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalecart/events": "*",
    "@scalecart/service-kit": "*",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
