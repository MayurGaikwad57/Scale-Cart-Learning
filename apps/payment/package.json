{
  "name": "@scalecart/payment",
  "version": "1.0.0",
  "private": true,
  "description": "Payment service: charges orders (OrderCreated -> PaymentSucceeded / PaymentFailed).",
  "type": "module",
  "exports": {
    "./*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "worker": "tsx --conditions=development src/worker.ts"
  },
  "dependencies": {
    "@scalecart/events": "*",
    "@scalecart/legacy-db": "*",
    "@scalecart/service-kit": "*",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
